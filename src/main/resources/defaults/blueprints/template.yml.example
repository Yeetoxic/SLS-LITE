# Canonical SLS-LITE blueprint using modern SLS terminology.
#
# Copy this file, choose a unique blueprint.id, and keep exact software versions
# quoted so YAML cannot reinterpret them as numbers.

blueprint:
  # Lowercase letters, numbers, underscores, and hyphens; maximum 64 characters.
  id: template
  # Human-readable name shown in commands and player messages.
  name: Template Server
  # Registry/category used by /sls join <type> <id>.
  type: game

server:
  # Must match a loaded software profile.
  software: paper
  # Exact version understood by that profile.
  version: "26.2"

  # Optional modern SLS-compatible server.properties overrides.
  configs:
    server.properties:
      parser: properties
      find:
        # Boolean, number, or single-line string. Disabled by default by Minecraft.
        enable-command-block: false
        # Resource packs require a client-reachable HTTP(S) URL. A copied
        # world/resources.zip is preserved but is not automatically public.
        # resource-pack: "https://cdn.example.net/packs/example.zip"
        # resource-pack-sha1: "0123456789abcdef0123456789abcdef01234567"
        # require-resource-pack: false
  limits:
    # Positive integer. Player slots available on each instance.
    max_players: 20
    # Positive integer. Maximum simultaneous instances for this blueprint.
    max_instances: 1
    # Positive integer MiB admission reservation for each instance.
    # Portable example baseline. Measure the selected software and plugins,
    # then size this within resources.total_memory_mib and the real host limit.
    memory_limit: 1024

# false creates an ephemeral instance; true preserves owned instance data and
# requires explicit reset when the blueprint/software definition changes.
save: false

# Sources are relative to plugins/sls-lite. Targets are confined below the
# prepared instance. Uncomment only the entries you actually provide.
#
# mode: cow creates a private mutable instance view using the best safe selected
# COW strategy, with transactional portable copy as the universal fallback.
# mode: ro creates a private source-protecting snapshot. Explicit rw shares
# persistent writable state and requires trusted plugins plus host directory-link
# support. Keep max_instances: 1 unless the software safely coordinates access.
# state:
#   volumes:
#     - name: world
#       source: volumes/worlds/example
#       target: /world
#       mode: cow
#   copy:
#     # Copy every plugin in a shared bundle into this instance.
#     - source: volumes/plugins/example/
#       target: plugins/
#     # Individual plugin files can also be copied to an exact target.
#     # - source: volumes/plugins/one-off.jar
#     #   target: plugins/one-off.jar
#   env:
#     FEATURE_FLAG: "true"

annotations:
  sls-lite:
    # Prevent automatic empty-server shutdown for priority services.
    keep-alive: false
    # Optional per-blueprint override; omit to use config.yml.
    # idle-shutdown-seconds: 180
    # Set false to disable empty-server shutdown for this blueprint.
    stop-when-empty: true
    # Optional bounded overrides for unusually slow startup or shutdown.
    # startup-timeout-seconds: 180
    # stop-timeout-seconds: 30
